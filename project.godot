; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="STAR REPLICA: AUTOMA"
config/description="自己複製特化型2D工場・宇宙艦隊シミュレーション (10,000 Swarm Fleet Edition)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/core/game_state.gd"
AudioSynth="*res://scripts/core/audio_synth.gd"
SaveManager="*res://scripts/core/save_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)
